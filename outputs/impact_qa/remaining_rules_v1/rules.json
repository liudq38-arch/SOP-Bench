{
  "version": "first_principles_v5",
  "date": "2026-09-28",
  "scope": "provisional_project_rules_not_original_author_rubric",
  "rules": [
    {
      "category": "wrong_tool",
      "working_definition": "工具与当前接口或操作不适配。",
      "required_evidence": [
        "确定实际接触工具和目标",
        "接口/能力适配参照",
        "正常换任务不能混入"
      ],
      "local_support_candidates": [
        "wt1",
        "wt2",
        "wt3"
      ],
      "boundary_or_unresolved_examples": [
        "wt4"
      ],
      "empirical_status": "3条局部更换链候选，精确槽口仍需核实",
      "constraint_basis": "物理接口与功能",
      "official_rule": false,
      "independent_validation": false
    },
    {
      "category": "wrong_part",
      "working_definition": "部件或紧固件身份/规格不适合当前所需角色。",
      "required_evidence": [
        "确定所需与实际部件",
        "验证规格不可互换",
        "区分朝向、放置与前置状态"
      ],
      "local_support_candidates": [],
      "boundary_or_unresolved_examples": [
        "wp1",
        "wp2",
        "wp3",
        "wp4",
        "wp5",
        "wp6",
        "wp7"
      ],
      "empirical_status": "7个原GT异常目标未验证错身份，不能代表剩余全池",
      "constraint_basis": "组件身份与功能；wrong_target作者归类未明确",
      "official_rule": false,
      "independent_validation": false
    },
    {
      "category": "spatial",
      "working_definition": "对象目的地、位置或方向违反适用要求。",
      "required_evidence": [
        "确定对象状态和实际目的地/朝向",
        "证明释放或限定为尝试",
        "指定盒位需任务约定"
      ],
      "local_support_candidates": [
        "spatial_rules_v1:p6_spatial",
        "spatial_rules_v1:p9_spatial"
      ],
      "boundary_or_unresolved_examples": [
        "spatial_rules_v1:p10_spatial"
      ],
      "empirical_status": "沿用上一轮两个同次执行局部案例；非本轮新增",
      "constraint_basis": "配合几何可以物理约束，料盒编号需要约定",
      "official_rule": false,
      "independent_validation": false
    },
    {
      "category": "handling",
      "working_definition": "抓持、支撑或释放中失去控制，或可见执行失效。",
      "required_evidence": [
        "直接接触/释放轨迹",
        "区分意外掉落与允许落台",
        "同时检查另一只手及目标结果"
      ],
      "local_support_candidates": [
        "h6",
        "h7"
      ],
      "boundary_or_unresolved_examples": [
        "h1",
        "h2",
        "h3",
        "h4",
        "h5"
      ],
      "empirical_status": "新增两位参与者短事件控制失误候选，非力矩/损坏认证",
      "constraint_basis": "保持控制为任务工作假设；允许直接落台仍待核实",
      "official_rule": false,
      "independent_validation": false
    },
    {
      "category": "procedural",
      "working_definition": "必要前置状态不满足、必做步骤遗漏或状态转换不成立。",
      "required_evidence": [
        "明确适用前置条件",
        "证实当时缺失",
        "排除独立步骤换序/试配/合法返工"
      ],
      "local_support_candidates": [],
      "boundary_or_unresolved_examples": [
        "pr1",
        "pr2",
        "pr3",
        "pr4",
        "pr5"
      ],
      "empirical_status": "pr1有完整重开返工链，因果仍待验证",
      "constraint_basis": "机械必要依赖或明确任务约定，非演示全序",
      "official_rule": false,
      "independent_validation": false
    },
    {
      "category": "temporal",
      "working_definition": "违反有依据的时机/持续时间约束；另保留可避免无进展候选。",
      "required_evidence": [
        "时间要求出处或停滞依据",
        "完整双手活动",
        "排除必要操作/检查/等待"
      ],
      "local_support_candidates": [],
      "boundary_or_unresolved_examples": [
        "t1",
        "t2",
        "t3",
        "t4",
        "t5"
      ],
      "empirical_status": "未确认数值阈值或作者效率类边界",
      "constraint_basis": "任务约定与效率假设，不能仅从物理结构推秒数",
      "official_rule": false,
      "independent_validation": false
    }
  ],
  "do_not_infer": [
    "unused_tool_is_error",
    "holding_tool_while_storing_is_error",
    "long_duration_is_temporal",
    "repeat_is_handling",
    "different_from_demonstration_is_procedural",
    "same_component_retry_is_wrong_part",
    "unresolved_is_correct"
  ],
  "raw_annotations_preserved": true,
  "production_prompt_modified": false,
  "qa_policy": {
    "facts": "allow_only_scope_and_identity_verified_facts",
    "causes": "hold_if_constraint_or_observation_unresolved",
    "mcq": "retain_native_and_reviewed_answers_separately; resolve_or_exclude_conflicts",
    "multiple_labels": "independent_evidence_per_label; preserve_intervals",
    "single_choice": "only_one_verified_type_in_audited_scope",
    "correct": "positive_in_scope_verification_not_unknown"
  }
}