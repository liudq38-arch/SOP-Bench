  "fixed_mcq": {
    "constructed_by": "deterministic_gt_builder",
    "shuffle_options": false,
    "correctness": {
      "selection": "single",
      "question": "How is the target-hand operation in the specified interval annotated?",
      "options": [
        {
          "id": "A",
          "text": "Correct (no annotated anomaly in this scope)"
        },
        {
          "id": "B",
          "text": "Anomalous"
        }
      ],
      "normal_source": "explicit_TAS-B_normal_without_same_hand_anomaly_or_recovery_overlap",
      "exclude_phases": [
        "recovery",
        "mixed",
        "unknown"
      ]
    },
    "anomaly_types": {
      "selection": "multiple",
      "question": "Which anomaly types are annotated for the target-hand operation in the specified interval? Select all that apply.",
      "options": [
        {
          "id": "A",
          "text": "Temporal",
          "attribute": "error_temporal"
        },
        {
          "id": "B",
          "text": "Spatial",
          "attribute": "error_spatial"
        },
        {
          "id": "C",
          "text": "Handling",
          "attribute": "error_handling"
        },
        {
          "id": "D",
          "text": "Wrong part",
          "attribute": "error_wrong_part"
        },
        {
          "id": "E",
          "text": "Wrong tool",
          "attribute": "error_wrong_tool"
        },
        {
          "id": "F",
          "text": "Procedural",
          "attribute": "error_procedural"
        }
      ],
      "require_anomalous": true
