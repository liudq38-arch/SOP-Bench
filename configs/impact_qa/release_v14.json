{
  "version": "candidate_release_v14",
  "scope": "recoverable_full_scale_candidates_not_public_gold_benchmark",
  "thresholds": {
    "hard_check_pass_rate": 1.0,
    "severe_defects": 0,
    "overall_quality_pass_rate": 0.95,
    "per_kind_quality_pass_rate": 0.9,
    "visual_evidence_pass_rate": 0.95,
    "completion_rate": 0.99,
    "min_independent_events_per_kind": 30,
    "min_validation_trials": 5,
    "min_validation_participants": 3
  },
  "require": ["frozen_pipeline", "independent_trials", "source_and_media_checks", "mcq_unique", "no_gt_leakage", "no_cross_split_trial_overlap", "reviewed_rejected_sample", "bias_report", "resume_verified", "agent_or_human_evidence_review"],
  "allow_model_self_review_as_quality_acceptance": false,
  "binary_max_answer_share_for_balanced_subset": 0.7,
  "target_broader_validation_trials": 16,
  "target_broader_validation_participants": 8,
  "small_scope_note": "5 trial/3 participant minimum applies only to explicitly limited candidate production; original 16/8 coverage target remains unmet if unavailable. Must be fixed before reserve inspection.",
  "release_by_kind": true,
  "full_batch_events": 500,
  "batch_review_fraction": 0.1,
  "batch_review_min_events": 50,
  "abort_on_severe_defect": true
}
